---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { SITE, type Lang } from '~/i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Locale-relative path of the current page (no /fr prefix), e.g. '/' or '/services'. */
  path?: string;
}
const { title, description, lang = 'en', path = '/' } = Astro.props;
const fullTitle = `${title} — ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/*
  Matomo — self-hosted on our own EU (OVH) box, so visitor data never leaves
  infrastructure we control. That matters here: the site sells EU hosting and
  GDPR-by-default, and a US analytics SaaS would quietly contradict it.

  Configured for the CNIL consent exemption (first-party cookies only, no User ID,
  no e-commerce, IP anonymised), which is why there is no cookie banner.

  Values are public by nature — they appear in the page source — so they are
  defaulted inline rather than required as CI secrets, and stay overridable via
  env for a staging instance.
*/
const MATOMO_URL = import.meta.env.PUBLIC_MATOMO_URL ?? 'https://analytics.nitroxconsulting.com/';
const MATOMO_SITE_ID = import.meta.env.PUBLIC_MATOMO_SITE_ID ?? '1';
// Only track real visitors: never count `npm run dev`, and allow opt-out by
// setting PUBLIC_MATOMO_SITE_ID to an empty string.
const trackingEnabled = import.meta.env.PROD && Boolean(MATOMO_SITE_ID);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* hreflang alternates so search engines pair the EN root with its /fr mirror */}
    <link rel="alternate" hreflang="en" href={new URL(path === '/' ? '/' : path, Astro.site).href} />
    <link rel="alternate" hreflang="fr" href={new URL(path === '/' ? '/fr' : '/fr' + path, Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(path === '/' ? '/' : path, Astro.site).href} />
    {/* Favicon — same set as nitroxbrain.com */}
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/hero-terminal.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Reason: set the theme class before paint to avoid a light/dark flash. Default light
         (2026-08-26): the audience is SMB owners, for whom a charcoal page reads as unwelcoming.
         Dark is opt-in via the header toggle and persists in `nx-theme`. Deliberately does NOT
         follow prefers-color-scheme — a dark-preferring visitor would still land on charcoal,
         which is exactly what this change is meant to stop. -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('nx-theme');
          if (saved === 'dark') document.documentElement.classList.add('dark');
          else document.documentElement.classList.remove('dark');
        } catch (e) {}
      })();
    </script>
    {
      trackingEnabled && (
        <script
          is:inline
          define:vars={{ matomoUrl: MATOMO_URL, matomoSiteId: MATOMO_SITE_ID }}
          set:html={`
            var _paq = (window._paq = window._paq || []);
            _paq.push(['setTrackerUrl', matomoUrl + 'matomo.php']);
            _paq.push(['setSiteId', matomoSiteId]);
            _paq.push(['setSecureCookie', true]);
            _paq.push(['trackPageView']);
            _paq.push(['enableLinkTracking']);
            (function () {
              var d = document,
                g = d.createElement('script'),
                s = d.getElementsByTagName('script')[0];
              g.async = true;
              g.src = matomoUrl + 'matomo.js';
              s.parentNode.insertBefore(g, s);
            })();
          `}
        />
      )
    }
  </head>
  <body class="min-h-screen">
    <Header lang={lang} path={path} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
