---
interface Action {
  label: string;
  href: string;
  variant?: 'primary' | 'ghost';
}
interface Props {
  tagline?: string;
  title: string;
  subtitle?: string;
  actions?: Action[];
}
const { tagline, title, subtitle, actions = [] } = Astro.props;
---

{/*
  Typographic hero — no background image (2026-08-26).

  Replaces the dark trading-terminal photo: it was a leftover from the pre-2026
  financial-consulting positioning and the main remaining reason the site read as
  "un site de hacker" to the SMB owners we now sell to.

  Everything here is built from the semantic tokens (page/surface/text/muted/primary),
  so it works in BOTH themes — dark is still available from the header toggle.
*/}
<section class="relative isolate overflow-hidden border-b border-token">
  {/* Soft brand wash: gives the band shape without needing an image. */}
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-primary/8 via-transparent to-transparent"></div>

  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32 lg:py-36">
    <div class="max-w-3xl">
      {
        tagline && (
          <p class="mb-4 flex items-center gap-3 text-sm font-semibold uppercase tracking-wider text-primary">
            <span aria-hidden="true" class="inline-block h-px w-8 bg-primary" />
            {tagline}
          </p>
        )
      }
      <h1 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
        <Fragment set:html={title} />
      </h1>
      {subtitle && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{subtitle}</p>}
      {
        actions.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-3">
            {actions.map((a) =>
              a.variant === 'ghost' ? (
                <a
                  href={a.href}
                  class="rounded-md border border-token px-5 py-2.5 text-base font-medium hover:border-primary hover:text-primary"
                >
                  {a.label}
                </a>
              ) : (
                <a
                  href={a.href}
                  class="rounded-md bg-brand-500 px-5 py-2.5 text-base font-semibold text-white hover:bg-brand-600"
                >
                  {a.label}
                </a>
              )
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
