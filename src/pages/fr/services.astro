---
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import Features from '~/components/Features.astro';
import CTA from '~/components/CTA.astro';

const build = [
  {
    title: 'Assistants agentiques',
    description: 'Déployez une IA là où votre équipe travaille déjà — chat, email, documents — et qui agit réellement, en toute sécurité.',
    icon: 'tabler:robot',
  },
  {
    title: 'RAG & bases de connaissances',
    description: 'Rendez vos documents, données et historiques recherchables et interrogeables, avec isolation par utilisateur et résidence UE.',
    icon: 'tabler:database-search',
  },
  {
    title: 'Automatisation & tâches planifiées',
    description: 'Briefings récurrents, veilles et workflows multi-étapes qui s’exécutent sans surveillance et rendent compte.',
    icon: 'tabler:clock-cog',
  },
];

const deliver = [
  {
    title: 'Intégration à vos outils',
    description: 'Connectez l’IA aux systèmes que vous utilisez déjà — Google, Microsoft, Slack, votre CRM et vos API internes — pour qu’elle agisse, pas seulement qu’elle réponde.',
    icon: 'tabler:plug-connected',
  },
  {
    title: 'Cloud & déploiement',
    description: 'Déploiements conteneurisés, scale-to-zero sur GCP / Azure / AWS, avec des défauts de coût et de sécurité sains.',
    icon: 'tabler:cloud-cog',
  },
  {
    title: 'Sûre et conforme par conception',
    description: 'Garde-fous, isolation par utilisateur, actions auditables et RGPD / résidence des données en UE — une IA à mettre entre les mains de vrais utilisateurs.',
    icon: 'tabler:shield-check',
  },
];

const enable = [
  {
    title: 'Stratégie & faisabilité IA',
    description: 'Là où l’IA rapporte vraiment pour votre équipe — et là où non. Un cadrage honnête avant de dépenser.',
    icon: 'tabler:route',
  },
  {
    title: 'Formation',
    description: 'Des formations concrètes qui rendent vos équipes autonomes avec l’IA — sur vos propres cas d’usage, pas des diapositives.<br /><a href="/fr/formations" class="text-primary hover:underline">Voir nos formations →</a>',
    icon: 'tabler:school',
  },
  {
    title: 'Accompagnement continu',
    description: 'Un partenaire du premier cadrage jusqu’à un système qui tourne et reste maintenu — adoption et montée en compétence incluses.<br /><a href="/fr/accompagnement" class="text-primary hover:underline">Accompagnement →</a>',
    icon: 'tabler:trending-up',
  },
];
---

<Layout
  title="Services"
  description="Ce que fait NitroX Consulting : systèmes d’IA agentique, intégration et déploiement, et stratégie, formation et accompagnement IA — une équipe responsable."
  lang="fr"
  path="/services"
>
  <Hero
    tagline="Services"
    title="Trois pratiques. Une équipe responsable."
    subtitle="Nous prenons les problèmes d’IA de bout en bout — de la faisabilité à un système en production, maintenu ensuite."
    actions={[{ label: 'Nous contacter', href: '/fr/contact', variant: 'primary' }]}
  />

  <Section tagline="Construire" title="Systèmes d’IA agentique" subtitle="Une IA autonome et contrôlable qui agit sur vos données — l’ingénierie derrière NitroxBrain.">
    <Features items={build} columns={3} />
  </Section>

  <Section surface tagline="Livrer" title="Intégration, déploiement & maîtrise" subtitle="Mettre l’IA en production, branchée à vos outils, et sûre à exploiter.">
    <Features items={deliver} columns={3} />
  </Section>

  <Section tagline="Autonomiser" title="Stratégie, formation & accompagnement" subtitle="Du cadrage honnête à des équipes qui maîtrisent leur IA — nous transmettons, nous ne vous enfermons pas.">
    <Features items={enable} columns={3} />
  </Section>

  <CTA
    title="Vous ne savez pas de quoi vous avez besoin ?"
    subtitle="C’est le rôle d’une première conversation. Nous vous aidons à cadrer — sans engagement."
    actions={[{ label: 'Prendre rendez-vous', href: '/fr/contact', variant: 'primary' }]}
  />
</Layout>
