---
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import Features from '~/components/Features.astro';
import CTA from '~/components/CTA.astro';

const build = [
  {
    title: 'Un assistant qui agit',
    description:
      'Une IA disponible là où votre équipe travaille déjà — messagerie, email, documents — et qui fait le travail, pas seulement qui répond.',
    icon: 'tabler:robot',
  },
  {
    title: 'Vos documents, interrogeables',
    description:
      'Contrats, procédures, comptes rendus, dossiers clients : vos équipes posent une question et obtiennent une réponse tirée de vos propres documents, avec ses sources.',
    icon: 'tabler:database-search',
  },
  {
    title: 'Tâches automatiques et récurrentes',
    description:
      'Un briefing chaque matin, une veille qui tourne toute seule, plusieurs tâches enchaînées sans surveillance — et un compte rendu de ce qui a été fait.',
    icon: 'tabler:clock-cog',
  },
];

const deliver = [
  {
    title: 'Branché à vos outils',
    description:
      'Nous connectons l’IA aux systèmes que vous utilisez déjà — Google, Microsoft, Slack, votre CRM, vos logiciels internes — pour qu’elle agisse, et pas seulement qu’elle discute.',
    icon: 'tabler:plug-connected',
  },
  {
    title: 'Hébergement et exploitation',
    description:
      'Hébergement sur Google Cloud, Azure ou AWS, dimensionné pour ne vous coûter que ce que vous utilisez réellement. Nous l’installons, nous le maintenons.',
    icon: 'tabler:cloud-cog',
  },
  {
    title: 'Sûre dès la conception',
    description:
      'Chacun ne voit que ce à quoi il a droit, les actions sont enregistrées et vérifiables, et vos données peuvent rester hébergées dans l’Union européenne, conformément au RGPD.',
    icon: 'tabler:shield-check',
  },
];

const enable = [
  {
    title: 'Cadrage et faisabilité',
    description:
      'Là où l’IA vous rapporte vraiment — et là où elle ne vous apportera rien. Un avis honnête avant que vous ne dépensiez.',
    icon: 'tabler:route',
  },
  {
    title: 'Formation',
    description:
      'Des formations concrètes qui rendent vos équipes autonomes, sur vos propres cas plutôt que sur des diapositives.<br /><a href="/fr/formations" class="text-primary hover:underline">Voir nos formations →</a>',
    icon: 'tabler:school',
  },
  {
    title: 'Accompagnement dans la durée',
    description:
      'Un interlocuteur du premier cadrage jusqu’à une solution qui tourne et reste entretenue — adoption et montée en compétence comprises.<br /><a href="/fr/accompagnement" class="text-primary hover:underline">Accompagnement →</a>',
    icon: 'tabler:trending-up',
  },
];
---

<Layout
  title="Services"
  description="Ce que fait NitroX Consulting : des assistants IA connectés à vos outils, l’installation et l’exploitation, et le cadrage, la formation et l’accompagnement de vos équipes."
  lang="fr"
  path="/services"
>
  <Hero
    tagline="Services"
    title="Trois métiers. Un seul interlocuteur."
    subtitle="Nous prenons le sujet de bout en bout — depuis « est-ce que c’est faisable ? » jusqu’à une solution utilisée tous les jours, que nous continuons à entretenir."
    actions={[{ label: 'Réserver 30 minutes', href: '/fr/contact', variant: 'primary' }]}
  />

  <Section
    tagline="Construire"
    title="Des assistants qui font le travail"
    subtitle="Une IA connectée à vos données et à vos outils, qui reste sous votre contrôle — l’ingénierie derrière NitroxBrain."
  >
    <Features items={build} columns={3} />
  </Section>

  <Section
    surface
    tagline="Livrer"
    title="Installation, hébergement et maîtrise"
    subtitle="Passer de la maquette à un outil que vos équipes utilisent tous les jours, branché à vos systèmes et sûr à exploiter."
  >
    <Features items={deliver} columns={3} />
  </Section>

  <Section
    tagline="Rendre autonome"
    title="Cadrage, formation et accompagnement"
    subtitle="Du conseil honnête jusqu’à des équipes qui maîtrisent leur outil — nous transmettons, nous ne vous rendons pas dépendants."
  >
    <Features items={enable} columns={3} />
  </Section>

  <CTA
    title="Vous ne savez pas encore de quoi vous avez besoin ?"
    subtitle="C’est justement le rôle d’une première conversation. Trente minutes, sans engagement et sans frais."
    actions={[{ label: 'Réserver 30 minutes', href: '/fr/contact', variant: 'primary' }]}
  />
</Layout>
