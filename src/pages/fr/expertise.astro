---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import Features from '~/components/Features.astro';
import CTA from '~/components/CTA.astro';

const domains = [
  {
    title: 'IA agentique en production',
    description:
      'Des assistants IA multi-utilisateurs qui lisent les outils, agissent sur les données et restent contrôlables — conçus, livrés et opérés par nous.',
    icon: 'tabler:robot',
  },
  {
    title: 'Recherche & connaissances (RAG)',
    description:
      'Transformer des données éparses et désordonnées en une base de connaissances que votre IA sait exploiter — juste, sourcée et isolée par utilisateur.',
    icon: 'tabler:database-search',
  },
  {
    title: 'Automatisation & agents IA',
    description:
      'Briefings planifiés, veilles et agents multi-étapes qui font un vrai travail sans surveillance — avec les garde-fous qui vont avec.',
    icon: 'tabler:clock-cog',
  },
  {
    title: 'Livraison multi-plateforme',
    description:
      'Un seul assistant sur Google Chat, Slack et Microsoft Teams, branché aux outils et aux API que votre équipe utilise déjà.',
    icon: 'tabler:plug-connected',
  },
  {
    title: 'IA sûre et maîtrisée',
    description:
      'Garde-fous, actions auditables, isolation par utilisateur et résidence des données en UE — la rigueur d’ingénierie pour exploiter l’IA face à de vrais utilisateurs.',
    icon: 'tabler:shield-check',
  },
  {
    title: 'Formation & montée en compétence IA',
    description:
      'Enseignement concret et suivi qui rendent une équipe réellement productive avec l’IA — sans dépendre de nous.',
    icon: 'tabler:school',
  },
];

const track = [
  {
    year: '2025–2026',
    title: 'NitroxBrain',
    href: 'https://nitroxbrain.com',
    body: 'Conception et livraison d’un second cerveau IA multi-utilisateurs en production sur Google Chat, Slack et Microsoft Teams — approuvé sur le Microsoft Teams Store, résident UE et RGPD d’abord.',
  },
  {
    year: '2026',
    title: 'SailingRouter',
    href: 'https://sailingrouter.com',
    body: 'Une plateforme web de routage météo avec calcul d’itinéraire optimal en temps réel — la preuve que nous menons des produits riches en données jusqu’en production.',
  },
  {
    year: '2001–2024',
    title: 'Deux décennies d’ingénierie à fort enjeu',
    body: 'Avant l’IA, nous avons construit des systèmes de pricing, de risque et de modélisation pour les marchés de capitaux — où un bug coûte cher. Cette rigueur est le socle de tout ce que nous livrons aujourd’hui en IA.',
  },
];
---

<Layout
  title="Expertise"
  description="L’expertise de NitroX Consulting : IA agentique en production, recherche et RAG, automatisation, livraison multi-plateforme et IA maîtrisée — avec deux décennies d’ingénierie à fort enjeu derrière."
  lang="fr"
  path="/expertise"
>
  <Hero
    tagline="Expertise"
    title="Profonds en IA, pas une large brochure."
    subtitle="Nous faisons quelques choses à haut niveau : des systèmes d’IA en production, la recherche qui les rend utiles, et la rigueur d’ingénierie pour les exploiter en toute sûreté."
    actions={[{ label: 'Travailler avec nous', href: '/fr/contact', variant: 'primary' }]}
  />

  <Section
    tagline="Domaines"
    title="Ce que nous maîtrisons en profondeur"
    subtitle="L’ingénierie IA moderne, livrée avec la discipline de deux décennies de systèmes régulés à fort enjeu."
  >
    <Features items={domains} columns={3} />
  </Section>

  <Section surface tagline="Parcours" title="De l’ingénierie à fort enjeu à l’IA en production" subtitle="Une sélection de ce que nous avons livré.">
    <div class="space-y-6">
      {
        track.map((t) => (
          <div class="flex flex-col gap-2 rounded-xl border border-token bg-surface p-6 sm:flex-row sm:gap-8">
            <div class="shrink-0 text-sm font-semibold uppercase tracking-wider text-primary sm:w-32">{t.year}</div>
            <div>
              <h3 class="text-lg font-semibold">
                {
                  t.href ? (
                    <a href={t.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-primary">
                      {t.title}
                      <Icon name="tabler:external-link" class="h-4 w-4 opacity-60" />
                    </a>
                  ) : (
                    t.title
                  )
                }
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-muted" set:html={t.body} />
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <CTA
    title="Besoin d’une IA construite avec une vraie rigueur ?"
    subtitle="L’ingénierie IA moderne alliée à un jugement du risque durement acquis, c’est rare. Si c’est ce qu’exige votre problème, parlons-en."
    actions={[{ label: 'Nous contacter', href: '/fr/contact', variant: 'primary' }]}
  />
</Layout>
