---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import Features from '~/components/Features.astro';
import CTA from '~/components/CTA.astro';

const domains = [
  {
    title: 'Des assistants qui font le travail',
    description:
      'Des assistants IA partagés par toute une équipe, qui lisent vos outils, agissent sur vos données et restent sous votre contrôle — conçus, installés et exploités par nous.',
    icon: 'tabler:robot',
  },
  {
    title: 'Retrouver l’information',
    description:
      'Transformer des données éparses et désordonnées en un savoir que vos équipes interrogent simplement — des réponses justes, avec leurs sources, et chacun ne voit que ce à quoi il a droit.',
    icon: 'tabler:database-search',
  },
  {
    title: 'Tâches automatiques',
    description:
      'Briefings planifiés, veilles et plusieurs tâches enchaînées qui font un vrai travail sans surveillance — avec les garde-fous qui vont avec.',
    icon: 'tabler:clock-cog',
  },
  {
    title: 'Dans les outils que vous utilisez',
    description:
      'Un seul assistant sur Google Chat, Slack et Microsoft Teams, branché aux logiciels que votre équipe utilise déjà.',
    icon: 'tabler:plug-connected',
  },
  {
    title: 'Sûre et maîtrisée',
    description:
      'Garde-fous, actions enregistrées et vérifiables, accès limités à chaque personne et hébergement possible dans l’Union européenne — la rigueur qu’exige une IA mise entre les mains de vrais utilisateurs.',
    icon: 'tabler:shield-check',
  },
  {
    title: 'Formation et montée en compétence',
    description:
      'Un enseignement concret et un suivi qui rendent une équipe réellement productive avec l’IA — sans dépendre de nous.',
    icon: 'tabler:school',
  },
];

const track = [
  {
    year: '2025–2026',
    title: 'NitroxBrain',
    href: 'https://nitroxbrain.com',
    body: 'Conception et livraison d’un assistant IA partagé, utilisé tous les jours dans Google Chat, Slack et Microsoft Teams — approuvé sur le Microsoft Teams Store, hébergeable dans l’UE et conçu RGPD d’abord.',
  },
  {
    year: '2026',
    title: 'SailingRouter',
    href: 'https://sailingrouter.com',
    body: 'Une plateforme web de routage météo qui calcule l’itinéraire optimal en temps réel — la preuve que nous menons jusqu’au bout des produits riches en données.',
  },
  {
    year: '1991–2024',
    title: 'Trente-cinq ans d’ingénierie à fort enjeu',
    body: 'Avant l’IA : dix ans de trading d’options sur les salles de marché de Paribas et Commerzbank, puis des systèmes de prix, de risque et de modélisation pour les banques, les fonds et les assureurs — là où une erreur se voit le jour même. Cette rigueur est le socle de tout ce que nous livrons aujourd’hui.',
  },
];
---

<Layout
  title="Expertise"
  description="L’expertise de NitroX Consulting : des assistants IA utilisés au quotidien, la recherche d’information dans vos documents, l’automatisation des tâches et une IA maîtrisée — appuyées sur trente-cinq ans d’ingénierie à fort enjeu."
  lang="fr"
  path="/expertise"
>
  <Hero
    tagline="Expertise"
    title="Peu de domaines, maîtrisés en profondeur."
    subtitle="Nous ne prétendons pas tout faire. Nous maîtrisons quelques sujets à fond : des assistants IA que les équipes utilisent vraiment, la recherche qui les rend utiles, et la rigueur nécessaire pour les exploiter sans danger."
    actions={[{ label: 'Réserver 30 minutes', href: '/fr/contact', variant: 'primary' }]}
  />

  <Section
    tagline="Domaines"
    title="Ce que nous maîtrisons en profondeur"
    subtitle="L’ingénierie IA moderne, livrée avec la discipline de trente-cinq ans de systèmes régulés à fort enjeu."
  >
    <Features items={domains} columns={3} />
  </Section>

  <Section
    surface
    tagline="Parcours"
    title="Des salles de marché à l’IA du quotidien"
    subtitle="Une sélection de ce que nous avons livré."
  >
    <div class="space-y-6">
      {
        track.map((t) => (
          <div class="flex flex-col gap-2 rounded-xl border border-token bg-surface p-6 sm:flex-row sm:gap-8">
            <div class="shrink-0 text-sm font-semibold uppercase tracking-wider text-primary sm:w-32">{t.year}</div>
            <div>
              <h3 class="text-lg font-semibold">
                {
                  t.href ? (
                    <a
                      href={t.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 hover:text-primary"
                    >
                      {t.title}
                      <Icon name="tabler:external-link" class="h-4 w-4 opacity-60" />
                    </a>
                  ) : (
                    t.title
                  )
                }
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-muted" set:html={t.body} />
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <CTA
    title="Besoin d’une IA construite avec une vraie rigueur ?"
    subtitle="L’ingénierie IA moderne alliée à un jugement du risque durement acquis, c’est rare. Si c’est ce qu’exige votre problème, parlons-en."
    actions={[{ label: 'Réserver 30 minutes', href: '/fr/contact', variant: 'primary' }]}
  />
</Layout>
