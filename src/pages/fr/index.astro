---
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import Features from '~/components/Features.astro';
import CTA from '~/components/CTA.astro';

const services = [
  {
    title: 'Assistants IA agentiques',
    description:
      'Des assistants autonomes qui lisent vos outils, agissent sur vos données et restent sous votre contrôle. Nous avons créé <strong>NitroxBrain</strong> — notre propre second cerveau IA multi-utilisateurs — et nous déployons la même ingénierie pour vous.',
    icon: 'tabler:robot',
  },
  {
    title: 'Automatisation & agents IA',
    description:
      'Briefings récurrents, veilles et workflows multi-étapes qui s’exécutent sans surveillance et rendent compte — les tâches ingrates prises en charge, pour que votre équipe se concentre sur l’essentiel.',
    icon: 'tabler:clock-cog',
  },
  {
    title: 'Bases de connaissances & RAG',
    description:
      'Transformez vos documents, données et historiques en un savoir que votre équipe interroge simplement — des réponses justes et sourcées, avec isolation par utilisateur et résidence UE.',
    icon: 'tabler:database-search',
  },
];

const proof = [
  {
    title: 'NitroxBrain',
    description:
      'Un assistant IA multi-utilisateurs en production sur Google Chat, Slack et Microsoft Teams — la preuve que nous construisons et opérons de l’IA réelle en production, approuvé sur le Microsoft Teams Store.',
    icon: 'tabler:brain',
  },
  {
    title: 'Agents & automatisation',
    description:
      'Briefings planifiés, veilles et agents multi-étapes qui tournent sans surveillance en production — une IA qui agit, pas seulement qui discute.',
    icon: 'tabler:robot',
  },
  {
    title: 'Ancrée & maîtrisée',
    description:
      'Recherche sur vos propres données, isolation par utilisateur, résidence UE et RGPD d’abord, avec des actions auditables et sûres.',
    icon: 'tabler:shield-check',
  },
];
---

<Layout
  title="Conseil & Ingénierie IA"
  description="NitroX Consulting conçoit, construit et opère des systèmes d’IA — assistants agentiques, automatisation et RAG — avec la rigueur de trente-cinq ans d’ingénierie dans des environnements à fort enjeu."
  lang="fr"
  path="/"
>
  <Hero
    tagline="Conseil & Ingénierie IA"
    title="Des systèmes d’IA réellement livrés —<br class='hidden sm:block'/> par des ingénieurs qui ont géré du vrai risque."
    subtitle="NitroX Consulting conçoit, construit et opère des systèmes d’IA pour les équipes qui veulent des résultats, pas des prototypes — avec la discipline de trente-cinq ans d’ingénierie en environnements à fort enjeu."
    actions={[
      { label: 'Nous contacter', href: '/fr/contact', variant: 'primary' },
      { label: 'Notre expertise', href: '/fr/expertise', variant: 'ghost' },
    ]}
  />

  <Section
    tagline="Ce que nous faisons"
    title="De l’idée à une IA en production"
    subtitle="Nous prenons un problème d’IA de bout en bout — conception, construction, déploiement et exploitation, là où votre équipe travaille déjà."
  >
    <Features items={services} columns={3} />
  </Section>

  <Section surface tagline="Pourquoi nous" title="La rigueur d’ingénierie, appliquée à l’IA">
    <div class="grid gap-8 md:grid-cols-2 md:items-center">
      <p class="text-lg leading-relaxed text-muted">
        Pendant trente-cinq ans, nous avons conçu des systèmes pour des environnements régulés à fort enjeu — où un bug coûte cher et
        où le «&nbsp;ça passera&nbsp;» n’a jamais suffi. Cette discipline — correcte, auditable, sûre à mettre entre les mains de vrais
        utilisateurs — est précisément ce qui manque à la plupart des projets d’IA. Nous l’apportons à l’IA : des assistants et des
        agents en qui vous pouvez vraiment avoir confiance en production.
      </p>
      <div class="grid grid-cols-2 gap-4">
        <div class="rounded-xl border border-token bg-surface p-6">
          <div class="text-3xl font-bold text-primary">3</div>
          <div class="mt-1 text-sm text-muted">Canaux IA en production (Chat · Slack · Teams)</div>
        </div>
        <div class="rounded-xl border border-token bg-surface p-6">
          <div class="text-3xl font-bold text-primary">35+</div>
          <div class="mt-1 text-sm text-muted">Ans d’ingénierie à fort enjeu</div>
        </div>
        <div class="rounded-xl border border-token bg-surface p-6">
          <div class="text-3xl font-bold text-primary">UE</div>
          <div class="mt-1 text-sm text-muted">Données résidentes, RGPD d’abord</div>
        </div>
        <div class="rounded-xl border border-token bg-surface p-6">
          <div class="text-3xl font-bold text-primary">Live</div>
          <div class="mt-1 text-sm text-muted">Notre propre IA, NitroxBrain, en production</div>
        </div>
      </div>
    </div>
  </Section>

  <Section tagline="Preuve" title="Nous livrons aussi notre propre IA" subtitle="La meilleure façon de juger un constructeur, c’est ce qu’il met en production.">
    <Features items={proof} columns={3} />
  </Section>

  <CTA
    title="Un problème à résoudre avec l’IA ?"
    subtitle="Dites-nous ce que vous aimeriez confier à l’IA. Si nous ne sommes pas les bons, nous vous le dirons."
    actions={[{ label: 'Démarrer la conversation', href: '/fr/contact', variant: 'primary' }]}
  />
</Layout>
