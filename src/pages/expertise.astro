---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import Features from '~/components/Features.astro';
import CTA from '~/components/CTA.astro';

const domains = [
  {
    title: 'Agentic AI in production',
    description:
      'Multi-user AI assistants that read tools, act on data and stay controllable — designed, shipped and operated by us, not outsourced.',
    icon: 'tabler:robot',
  },
  {
    title: 'Retrieval & knowledge (RAG)',
    description:
      'Turning messy, scattered data into a knowledge base your AI can answer from — accurate, sourced, and isolated per user.',
    icon: 'tabler:database-search',
  },
  {
    title: 'AI automation & agents',
    description:
      'Scheduled briefings, watchers and multi-step agents that do real work unattended — with the guardrails that belong with them.',
    icon: 'tabler:clock-cog',
  },
  {
    title: 'Multi-platform delivery',
    description:
      'One assistant across Google Chat, Slack and Microsoft Teams, plugged into the tools and APIs your team already uses.',
    icon: 'tabler:plug-connected',
  },
  {
    title: 'Safe & governed AI',
    description:
      'Guardrails, auditable actions, per-user isolation and EU data residency — the engineering rigour to run AI in front of real users.',
    icon: 'tabler:shield-check',
  },
  {
    title: 'AI enablement & training',
    description:
      'Hands-on teaching and follow-up that make a team genuinely productive with AI — not dependent on us.',
    icon: 'tabler:school',
  },
];

const track = [
  {
    year: '2025–2026',
    title: 'NitroxBrain',
    href: 'https://nitroxbrain.com',
    body: 'Designed and shipped a production multi-user AI second brain across Google Chat, Slack and Microsoft Teams — approved on the Microsoft Teams Store, EU-resident and GDPR-first.',
  },
  {
    year: '2026',
    title: 'SailingRouter',
    href: 'https://sailingrouter.com',
    body: 'A weather-routing web platform with real-time optimal-route computation — proof we take data-heavy products all the way to production.',
  },
  {
    year: '2001–2024',
    title: 'Two decades of high-stakes engineering',
    body: 'Before AI, we built pricing, risk and modelling systems for capital markets — where a bug costs real money. That rigour is the foundation under everything we now ship in AI.',
  },
];
---

<Layout
  title="Expertise"
  description="NitroX Consulting's expertise: agentic AI in production, retrieval and RAG, automation, multi-platform delivery and governed AI — with two decades of high-stakes engineering behind it."
  lang="en"
  path="/expertise"
>
  <Hero
    tagline="Expertise"
    title="Deep in AI, not a wide brochure."
    subtitle="We do a few things at a high level: production AI systems, the retrieval that makes them useful, and the engineering rigour to run them safely."
    actions={[{ label: 'Work with us', href: '/contact', variant: 'primary' }]}
  />

  <Section
    tagline="Domains"
    title="What we know deeply"
    subtitle="Modern AI engineering, delivered with the discipline of two decades in regulated, high-stakes systems."
  >
    <Features items={domains} columns={3} />
  </Section>

  <Section surface tagline="Track record" title="From high-stakes engineering to AI in production" subtitle="A selection of what we have shipped.">
    <div class="space-y-6">
      {
        track.map((t) => (
          <div class="flex flex-col gap-2 rounded-xl border border-token bg-surface p-6 sm:flex-row sm:gap-8">
            <div class="shrink-0 text-sm font-semibold uppercase tracking-wider text-primary sm:w-32">{t.year}</div>
            <div>
              <h3 class="text-lg font-semibold">
                {
                  t.href ? (
                    <a href={t.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-primary">
                      {t.title}
                      <Icon name="tabler:external-link" class="h-4 w-4 opacity-60" />
                    </a>
                  ) : (
                    t.title
                  )
                }
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-muted" set:html={t.body} />
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <CTA
    title="Need AI built with real rigour?"
    subtitle="Modern AI engineering plus hard-won risk judgement is uncommon. If that is what your problem needs, let us talk."
    actions={[{ label: 'Talk to us', href: '/contact', variant: 'primary' }]}
  />
</Layout>
