---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import Features from '~/components/Features.astro';
import CTA from '~/components/CTA.astro';

const domains = [
  {
    title: 'Assistants that do the work',
    description:
      'AI assistants shared by a whole team, that read your tools, act on your data and stay under your control — designed, installed and run by us, not outsourced.',
    icon: 'tabler:robot',
  },
  {
    title: 'Finding the answer',
    description:
      'Turning messy, scattered data into knowledge your team can simply ask — accurate answers with their sources, and everyone sees only what they should.',
    icon: 'tabler:database-search',
  },
  {
    title: 'Automatic tasks',
    description:
      'Scheduled briefings, watchers and several tasks chained together that do real work unattended — with the guardrails that belong with them.',
    icon: 'tabler:clock-cog',
  },
  {
    title: 'Inside the tools you already use',
    description:
      'One assistant across Google Chat, Slack and Microsoft Teams, plugged into the software your team already works in.',
    icon: 'tabler:plug-connected',
  },
  {
    title: 'Safe and controlled',
    description:
      'Guardrails, recorded and checkable actions, access limited per person and hosting available in the European Union — the rigour AI needs before real users touch it.',
    icon: 'tabler:shield-check',
  },
  {
    title: 'Training and skills',
    description:
      'Hands-on teaching and follow-up that make a team genuinely productive with AI — not dependent on us.',
    icon: 'tabler:school',
  },
];

const track = [
  {
    year: '2025–2026',
    title: 'NitroxBrain',
    href: 'https://nitroxbrain.com',
    body: 'Designed and shipped a shared AI assistant used every day across Google Chat, Slack and Microsoft Teams — approved on the Microsoft Teams Store, hostable in the EU and GDPR-first.',
  },
  {
    year: '2026',
    title: 'SailingRouter',
    href: 'https://sailingrouter.com',
    body: 'A weather-routing web platform that computes the optimal route in real time — proof we take data-heavy products all the way to the finish.',
  },
  {
    year: '1991–2024',
    title: 'Thirty-five years of high-stakes engineering',
    body: 'Before AI: ten years trading options on the Paribas and Commerzbank floors, then pricing, risk and modelling systems for banks, funds and insurers — where a mistake shows up the same day. That rigour is the foundation under everything we now ship.',
  },
];
---

<Layout
  title="Expertise"
  description="NitroX Consulting's expertise: AI assistants teams actually use, finding answers in your own documents, automating tasks and keeping it all controlled — with thirty-five years of high-stakes engineering behind it."
  lang="en"
  path="/expertise"
>
  <Hero
    tagline="Expertise"
    title="Few areas, mastered deeply."
    subtitle="We do not claim to do everything. We know a few subjects thoroughly: AI assistants teams genuinely use, the search that makes them useful, and the rigour to run them without danger."
    actions={[{ label: 'Book 30 minutes', href: '/contact', variant: 'primary' }]}
  />

  <Section
    tagline="Domains"
    title="What we know deeply"
    subtitle="Modern AI engineering, delivered with the discipline of thirty-five years in regulated, high-stakes systems."
  >
    <Features items={domains} columns={3} />
  </Section>

  <Section surface tagline="Track record" title="From trading floors to everyday AI" subtitle="A selection of what we have shipped.">
    <div class="space-y-6">
      {
        track.map((t) => (
          <div class="flex flex-col gap-2 rounded-xl border border-token bg-surface p-6 sm:flex-row sm:gap-8">
            <div class="shrink-0 text-sm font-semibold uppercase tracking-wider text-primary sm:w-32">{t.year}</div>
            <div>
              <h3 class="text-lg font-semibold">
                {
                  t.href ? (
                    <a href={t.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-primary">
                      {t.title}
                      <Icon name="tabler:external-link" class="h-4 w-4 opacity-60" />
                    </a>
                  ) : (
                    t.title
                  )
                }
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-muted" set:html={t.body} />
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <CTA
    title="Need AI built with real rigour?"
    subtitle="Modern AI engineering plus hard-won risk judgement is uncommon. If that is what your problem needs, let us talk."
    actions={[{ label: 'Book 30 minutes', href: '/contact', variant: 'primary' }]}
  />
</Layout>
