---
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import Features from '~/components/Features.astro';
import CTA from '~/components/CTA.astro';

const services = [
  {
    title: 'Agentic AI assistants',
    description:
      'Autonomous assistants that read your tools, act on your data, and stay under your control. We built <strong>NitroxBrain</strong> — our own multi-user AI second brain — and we deploy the same engineering for you.',
    icon: 'tabler:robot',
  },
  {
    title: 'AI automation & agents',
    description:
      'Recurring briefings, watchers, and multi-step workflows that run unattended and report back — the busywork handled, so your team does the work that matters.',
    icon: 'tabler:clock-cog',
  },
  {
    title: 'Knowledge & RAG systems',
    description:
      'Turn your documents, data and history into something your team can simply ask — accurate, sourced answers, with per-user isolation and EU residency.',
    icon: 'tabler:database-search',
  },
];

const proof = [
  {
    title: 'NitroxBrain',
    description:
      'A production multi-user AI assistant on Google Chat, Slack and Microsoft Teams — our flagship proof that we build and run real AI in production, approved on the Microsoft Teams Store.',
    icon: 'tabler:brain',
  },
  {
    title: 'Agents & automation',
    description:
      'Scheduled briefings, watchers and multi-step agents running unattended in production — AI that does things, not just chats.',
    icon: 'tabler:robot',
  },
  {
    title: 'Grounded & governed',
    description:
      'Retrieval over your own data, per-user isolation, EU-resident and GDPR-first, with actions that are auditable and safe to trust.',
    icon: 'tabler:shield-check',
  },
];
---

<Layout
  title="AI Consulting & Engineering"
  description="NitroX Consulting designs, builds and operates AI systems — agentic assistants, automation and RAG — with the engineering rigour of thirty-five years in high-stakes markets."
  lang="en"
  path="/"
>
  <Hero
    tagline="AI Consulting & Engineering"
    title="AI systems that actually ship —<br class='hidden sm:block'/> built by engineers who ran real risk."
    subtitle="NitroX Consulting designs, builds and operates AI systems for teams that need results, not prototypes — with the engineering discipline of thirty-five years in high-stakes markets."
    actions={[
      { label: 'Talk to us', href: '/contact', variant: 'primary' },
      { label: 'Our expertise', href: '/expertise', variant: 'ghost' },
    ]}
  />

  <Section
    tagline="What we do"
    title="From idea to AI running in production"
    subtitle="We take an AI problem end to end — design, build, deploy, and keep it running where your team already works."
  >
    <Features items={services} columns={3} />
  </Section>

  <Section surface tagline="Why us" title="Engineering rigour, applied to AI">
    <div class="grid gap-8 md:grid-cols-2 md:items-center">
      <p class="text-lg leading-relaxed text-muted">
        For thirty-five years we engineered systems for high-stakes, regulated environments — where a bug costs real money and
        &ldquo;probably fine&rdquo; is never good enough. That discipline — correct, auditable, safe to put in front of real users —
        is exactly what most AI projects lack. We bring it to AI: assistants and agents you can actually trust in production.
      </p>
      <div class="grid grid-cols-2 gap-4">
        <div class="rounded-xl border border-token bg-surface p-6">
          <div class="text-3xl font-bold text-primary">3</div>
          <div class="mt-1 text-sm text-muted">AI channels in production (Chat · Slack · Teams)</div>
        </div>
        <div class="rounded-xl border border-token bg-surface p-6">
          <div class="text-3xl font-bold text-primary">35+</div>
          <div class="mt-1 text-sm text-muted">Years of high-stakes engineering</div>
        </div>
        <div class="rounded-xl border border-token bg-surface p-6">
          <div class="text-3xl font-bold text-primary">EU</div>
          <div class="mt-1 text-sm text-muted">Data-resident, GDPR-first</div>
        </div>
        <div class="rounded-xl border border-token bg-surface p-6">
          <div class="text-3xl font-bold text-primary">Live</div>
          <div class="mt-1 text-sm text-muted">Our own AI, NitroxBrain, in production</div>
        </div>
      </div>
    </div>
  </Section>

  <Section tagline="Proof" title="We ship our own AI, too" subtitle="The fastest way to judge a builder is what they run in production.">
    <Features items={proof} columns={3} />
  </Section>

  <CTA
    title="Have a problem worth solving with AI?"
    subtitle="Tell us what you wish AI handled for your team. If we are the wrong fit, we will say so."
    actions={[{ label: 'Start a conversation', href: '/contact', variant: 'primary' }]}
  />
</Layout>
