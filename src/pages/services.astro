---
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import Features from '~/components/Features.astro';
import CTA from '~/components/CTA.astro';

const build = [
  {
    title: 'An assistant that acts',
    description:
      'AI available where your team already works — messaging, email, documents — that does the work, not just answers questions.',
    icon: 'tabler:robot',
  },
  {
    title: 'Your documents, answerable',
    description:
      'Contracts, procedures, meeting notes, client files: your team asks a question and gets an answer drawn from your own documents, with its sources.',
    icon: 'tabler:database-search',
  },
  {
    title: 'Automatic, recurring tasks',
    description:
      'A briefing every morning, a watch that runs on its own, several tasks chained together unattended — and a report of what was done.',
    icon: 'tabler:clock-cog',
  },
];

const deliver = [
  {
    title: 'Plugged into your tools',
    description:
      'We connect AI to the systems you already run — Google, Microsoft, Slack, your CRM, your internal software — so it acts rather than just talks.',
    icon: 'tabler:plug-connected',
  },
  {
    title: 'Hosting and operation',
    description:
      'Hosted on Google Cloud, Azure or AWS, sized so it only costs you what you actually use. We install it and we keep it running.',
    icon: 'tabler:cloud-cog',
  },
  {
    title: 'Safe by design',
    description:
      'Everyone sees only what they should, actions are recorded and checkable, and your data can stay hosted in the European Union under GDPR.',
    icon: 'tabler:shield-check',
  },
];

const enable = [
  {
    title: 'Scoping and feasibility',
    description:
      'Where AI genuinely pays off for you — and where it will do nothing for you. An honest answer before you spend.',
    icon: 'tabler:route',
  },
  {
    title: 'Training',
    description:
      'Hands-on training that makes your teams self-sufficient, on your own cases rather than slideware.<br /><a href="/formations" class="text-primary hover:underline">See our training →</a>',
    icon: 'tabler:school',
  },
  {
    title: 'Ongoing support',
    description:
      'One contact from first scoping to a solution that runs and stays maintained — adoption and skills included.<br /><a href="/accompagnement" class="text-primary hover:underline">AI Adoption →</a>',
    icon: 'tabler:trending-up',
  },
];
---

<Layout
  title="Services"
  description="What NitroX Consulting does: AI assistants connected to your tools, installation and hosting, and the scoping, training and support your teams need."
  lang="en"
  path="/services"
>
  <Hero
    tagline="Services"
    title="Three trades. One person to talk to."
    subtitle="We take the whole thing end to end — from “is this even feasible?” to a solution your team uses every day, which we keep maintained afterwards."
    actions={[{ label: 'Book 30 minutes', href: '/contact', variant: 'primary' }]}
  />

  <Section
    tagline="Build"
    title="Assistants that do the work"
    subtitle={`AI connected to your data and your tools, staying under your control — the engineering behind <a href="https://nitroxbrain.com" class="font-semibold text-primary underline underline-offset-2 hover:no-underline" target="_blank" rel="noopener noreferrer">NitroxBrain</a>.`}
  >
    <Features items={build} columns={3} />
  </Section>

  <Section
    surface
    tagline="Deliver"
    title="Installation, hosting and control"
    subtitle="Getting from a mock-up to a tool your team uses every day, plugged into your systems and safe to run."
  >
    <Features items={deliver} columns={3} />
  </Section>

  <Section
    tagline="Enable"
    title="Scoping, training and support"
    subtitle="From honest advice to teams that own their tool — we hand it over, we do not make you dependent."
  >
    <Features items={enable} columns={3} />
  </Section>

  <CTA
    title="Not sure yet which of these you need?"
    subtitle="That is exactly what a first conversation is for. Thirty minutes, no commitment and no charge."
    actions={[{ label: 'Book 30 minutes', href: '/contact', variant: 'primary' }]}
  />
</Layout>
