---
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import Features from '~/components/Features.astro';
import CTA from '~/components/CTA.astro';

const build = [
  {
    title: 'Agentic assistants',
    description: 'Deploy AI that lives where your team already works — chat, email, documents — and takes real actions safely.',
    icon: 'tabler:robot',
  },
  {
    title: 'RAG & knowledge systems',
    description: 'Make your own documents, data and history searchable and answerable, with per-user isolation and EU residency.',
    icon: 'tabler:database-search',
  },
  {
    title: 'Automation & scheduled tasks',
    description: 'Recurring briefings, watchers, and multi-step workflows that run unattended and report back.',
    icon: 'tabler:clock-cog',
  },
];

const deliver = [
  {
    title: 'Integration into your tools',
    description: 'Connect AI to the systems you already run — Google, Microsoft, Slack, your CRM and internal APIs — so it acts, not just answers.',
    icon: 'tabler:plug-connected',
  },
  {
    title: 'Cloud & deployment',
    description: 'Containerised, scale-to-zero deployments on GCP / Azure / AWS with sensible cost and security defaults.',
    icon: 'tabler:cloud-cog',
  },
  {
    title: 'Safe & compliant by design',
    description: 'Guardrails, per-user isolation, auditable actions and RGPD / EU data residency — AI you can put in front of real users.',
    icon: 'tabler:shield-check',
  },
];

const enable = [
  {
    title: 'AI strategy & feasibility',
    description: 'Where AI actually pays off for your team — and where it does not. Honest scoping before you spend.',
    icon: 'tabler:route',
  },
  {
    title: 'Training',
    description: 'Hands-on training that makes your teams autonomous with AI — on your own use cases, not slideware.<br /><a href="/formations" class="text-primary hover:underline">See our training →</a>',
    icon: 'tabler:school',
  },
  {
    title: 'Ongoing support',
    description: 'A partner from first scoping to a system that runs and stays maintained — adoption and enablement included.<br /><a href="/accompagnement" class="text-primary hover:underline">AI Adoption →</a>',
    icon: 'tabler:trending-up',
  },
];
---

<Layout
  title="Services"
  description="What NitroX Consulting does: agentic AI systems, integration and deployment, and AI strategy, training and support — one accountable team."
  lang="en"
  path="/services"
>
  <Hero
    tagline="Services"
    title="Three practices. One accountable team."
    subtitle="We take AI problems end to end — from feasibility to a system running in production and maintained afterwards."
    actions={[{ label: 'Talk to us', href: '/contact', variant: 'primary' }]}
  />

  <Section tagline="Build" title="Agentic AI systems" subtitle="Autonomous, controllable AI that acts on your data — the engineering behind NitroxBrain.">
    <Features items={build} columns={3} />
  </Section>

  <Section surface tagline="Deliver" title="Integration, deployment & governance" subtitle="Getting AI into production, plugged into your tools, and safe to run.">
    <Features items={deliver} columns={3} />
  </Section>

  <Section tagline="Enable" title="Strategy, training & support" subtitle="From honest scoping to teams that own their AI — we hand it over, we do not lock you in.">
    <Features items={enable} columns={3} />
  </Section>

  <CTA
    title="Not sure which of these you need?"
    subtitle="That is what a first conversation is for. We will help you scope it — no obligation."
    actions={[{ label: 'Book a call', href: '/contact', variant: 'primary' }]}
  />
</Layout>
